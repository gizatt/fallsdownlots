<mujoco model="two_wheel_balancer">
  <compiler angle="radian"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="RK4"/>

  <default>
    <joint damping="0.01" armature="0.01"/>
    <geom condim="3" friction="0.8 0.1 0.1"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1=".15 .25 .35" rgb2=".25 .35 .45"
             width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="4 4" texuniform="true"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <light pos="1 -1 1" dir="-1 1 -1" diffuse="0.3 0.3 0.3"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="grid" condim="3"/>

    <!--
      Chassis: represents the Altoids tin body + battery + electronics.
      Dimensions (half-sizes): 30mm x 25mm x 50mm  (x=forward, y=lateral, z=up)
      Total mass ~80g.
      Positioned so wheels just touch the floor: chassis center at z = wheel_radius + chassis_half_z
      wheel_radius = 0.035 m, chassis_half_z = 0.05 m  →  z = 0.085 m
      But wheels attach at z=-0.05 (relative to chassis center), so center of wheel axle
      is at z=0.035 from ground when chassis center is at z=0.085.
    -->
    <body name="chassis" pos="0 0 0.085">
      <freejoint name="chassis_free"/>
      <geom name="chassis_box" type="box" size="0.030 0.025 0.050"
            mass="0.080" rgba="0.70 0.45 0.20 1"/>
      <!-- IMU site at chassis geometric center -->
      <site name="imu_site" pos="0 0 0" size="0.004"/>

      <!--
        Left wheel: offset -y (left side), centered at chassis bottom face.
        Wheel: r=35mm, half-width=8mm.  Hinge axis along +y (lateral).
      -->
      <body name="left_wheel" pos="0 -0.040 -0.050">
        <!-- BLDC outrunner + ball bearings: near-zero passive friction.
             damping ~0.1 mNm·s/rad, armature = rotor inertia ~0.1 g·cm² -->
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0"
               damping="0.0001" armature="0.0001"/>
        <!-- euler="1.5708 0 0" rotates cylinder axis from Z to Y, matching the hinge axis -->
        <geom name="left_wheel_geom" type="cylinder" size="0.035 0.008"
              euler="1.5708 0 0"
              mass="0.020" rgba="0.20 0.20 0.75 1"
              friction="1.2 0.01 0.002"/>
      </body>

      <!--
        Right wheel: offset +y (right side).
      -->
      <body name="right_wheel" pos="0 0.040 -0.050">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0"
               damping="0.0001" armature="0.0001"/>
        <!-- euler="1.5708 0 0" rotates cylinder axis from Z to Y, matching the hinge axis -->
        <geom name="right_wheel_geom" type="cylinder" size="0.035 0.008"
              euler="1.5708 0 0"
              mass="0.020" rgba="0.20 0.20 0.75 1"
              friction="1.2 0.01 0.002"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!--
      Direct torque motors.  gear=1 means ctrl=1.0 → 1 Nm.
      Measured SimpleFOC stall torque is ~0.1–0.3 Nm at the wheel shaft,
      so the policy's [-1,1] output will be scaled by MAX_TORQUE_NM in sim.py
      and firmware.  Keep gear=1 here and do all scaling externally.
    -->
    <motor name="left_motor"  joint="left_wheel_joint"
           ctrllimited="true" ctrlrange="-1.0 1.0" gear="1"/>
    <motor name="right_motor" joint="right_wheel_joint"
           ctrllimited="true" ctrlrange="-1.0 1.0" gear="1"/>
  </actuator>

  <sensor>
    <!-- Body-frame gyro at the IMU site -->
    <gyro      name="imu_gyro"        site="imu_site"  noise="0.01"/>
    <!-- Chassis orientation as a quaternion [w, x, y, z] -->
    <framequat name="chassis_quat"    objtype="body" objname="chassis"/>
    <!-- Wheel angular velocities -->
    <jointvel  name="left_wheel_vel"  joint="left_wheel_joint"/>
    <jointvel  name="right_wheel_vel" joint="right_wheel_joint"/>
  </sensor>

</mujoco>
