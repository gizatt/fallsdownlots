<mujoco model="two_wheel_balancer">
  <compiler angle="radian"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="RK4"/>

  <default>
    <joint damping="0.01" armature="0.01"/>
    <geom condim="3" friction="0.8 0.1 0.1"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1=".15 .25 .35" rgb2=".25 .35 .45"
             width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="4 4" texuniform="true"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <light pos="1 -1 1" dir="-1 1 -1" diffuse="0.3 0.3 0.3"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="grid" condim="3"/>

    <!--
      Chassis: represents the Altoids tin body + battery + electronics.
      Altoids tin: 22mm deep x 65mm wide x 100mm tall  (x=depth, y=width, z=height)
      Half-sizes: x=0.011, y=0.0325, z=0.050
      Total mass ~80g.
      Wheel axle is 4mm up from tin bottom → axle at z = -0.046 relative to chassis center.
      wheel_radius = 0.035 m  →  chassis center z = 0.035 + 0.046 = 0.081 m
    -->
    <body name="chassis" pos="0 0 0.081">
      <freejoint name="chassis_free"/>
      <!--
        Total assembly mass: 172g.  Wheels assumed 20g each → chassis 132g.
        Overall COM is 28mm from tin bottom = -22mm from chassis center.
        Back-solving with wheels at z=-46mm: chassis COM at z=-14.7mm from chassis center.
        Inertia computed for a uniform box at chassis center (close enough).
        I_x=1.57e-4, I_y=1.15e-4, I_z=5.18e-5 kg·m² (x=depth, y=width, z=height)
      -->
      <inertial pos="0 0 -0.0147" mass="0.132"
                diaginertia="1.57e-4 1.15e-4 5.18e-5"/>
      <geom name="chassis_box" type="box" size="0.011 0.0325 0.050"
            rgba="0.70 0.45 0.20 1"/>
      <!-- IMU site at chassis geometric center -->
      <site name="imu_site" pos="0 0 0" size="0.004"/>

      <!--
        Left wheel: offset -y (left side), axle 4mm above tin bottom.
        Wheel: r=35mm, half-width=7.5mm.  Inside edge 41mm from center → center at y=-48.5mm.
        Hinge axis along +y (lateral).
      -->
      <body name="left_wheel" pos="0 -0.0485 -0.046">
        <!-- BLDC outrunner + ball bearings: near-zero passive friction.
             damping ~0.1 mNm·s/rad, armature = rotor inertia ~0.1 g·cm² -->
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0"
               damping="0.0001" armature="0.0001"/>
        <!-- euler="1.5708 0 0" rotates cylinder axis from Z to Y, matching the hinge axis -->
        <geom name="left_wheel_geom" type="cylinder" size="0.035 0.0075"
              euler="1.5708 0 0"
              mass="0.020" rgba="0.20 0.20 0.75 1"
              friction="1.2 0.01 0.002"/>
      </body>

      <!--
        Right wheel: offset +y (right side), axle 4mm above tin bottom.
        Center at y=+48.5mm.
      -->
      <body name="right_wheel" pos="0 0.0485 -0.046">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0"
               damping="0.0001" armature="0.0001"/>
        <!-- euler="1.5708 0 0" rotates cylinder axis from Z to Y, matching the hinge axis -->
        <geom name="right_wheel_geom" type="cylinder" size="0.035 0.0075"
              euler="1.5708 0 0"
              mass="0.020" rgba="0.20 0.20 0.75 1"
              friction="1.2 0.01 0.002"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!--
      Velocity-servo actuators.  ctrl = target wheel angular velocity [rad/s].
      kv is the velocity gain: torque = kv * (ctrl - joint_vel)  [Nm/(rad/s)].
      forcerange clips the resulting torque to the motor stall limit (~0.3 Nm).
      ctrlrange limits commanded velocity; ±50 rad/s ≈ ±1.75 m/s at the wheel.
      (Inspired by upkie: kv="0.05" forcerange="-1.7 1.7"; scaled down for this robot.)
    -->
    <velocity name="left_motor"  joint="left_wheel_joint"
              kv="0.05" forcerange="-0.3 0.3"
              ctrllimited="true" ctrlrange="-50 50"/>
    <velocity name="right_motor" joint="right_wheel_joint"
              kv="0.05" forcerange="-0.3 0.3"
              ctrllimited="true" ctrlrange="-50 50"/>
  </actuator>

  <sensor>
    <!-- Body-frame gyro at the IMU site -->
    <gyro      name="imu_gyro"        site="imu_site"  noise="0.01"/>
    <!-- Chassis orientation as a quaternion [w, x, y, z] -->
    <framequat name="chassis_quat"    objtype="body" objname="chassis"/>
    <!-- Wheel angular velocities -->
    <jointvel  name="left_wheel_vel"  joint="left_wheel_joint"/>
    <jointvel  name="right_wheel_vel" joint="right_wheel_joint"/>
  </sensor>

</mujoco>
